(* Annotated curried bodies share the same final result layout. *)
let rec first count = ((fun seed -> if count == 0 then { b = seed + 7, a = 1 } else (second (count - 1) seed : { a : int, b : int })) : int -> { a : int, b : int })
and second count = ((fun seed -> if count == 0 then { a = 2, b = seed + 8 } else (first (count - 1) seed : { a : int, b : int })) : int -> { a : int, b : int })
let read r = (r : { a : int, b : int }).b
let shown = print_int (read (first 100000 0))
let main = print_int (read (first 100001 0))
