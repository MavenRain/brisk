(* Body and call annotations agree with the final recursive result layout. *)
let rec first count = ((if count == 0 then { b = 7, a = 1 } else (second (count - 1) : { a : int, b : int })) : { a : int, b : int })
and second count = ((if count == 0 then { a = 2, b = 8 } else (first (count - 1) : { a : int, b : int })) : { a : int, b : int })
let read r = (r : { a : int, b : int }).b
let shown = print_int (read (first 100000))
let main = print_int (read (first 100001))
