(* A variant payload contains records whose fields change branch order. *)
let rec first count = match count with | 0 -> < full { b = 7, a = 1 } > | remaining -> second (remaining - 1)
and second count = match count with | 0 -> < full { a = 2, b = 8 } > | remaining -> first (remaining - 1)
let read v = match (v : < skip : int, full : { a : int, b : int } >) with | < skip n > -> n + 100 | < full r > -> r.b
let shown = print_int (read (first 100000))
let main = print_int (read (first 100001))
