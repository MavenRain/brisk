let inner v = match (v : < hit : int, miss : int >) with | < hit n > -> n | < miss n > -> n
let choose r = match (r : { tag : < hit : int, miss : int >, step : int }) with | { tag = < hit 0 >, step = 0 } -> { a = 1, b = 100 } | { step = step, tag = < hit n > } -> { b = n + step, a = 2 } | { tag = < miss n >, step = 0 } -> { b = n + 10, a = 3 } | whole -> { a = 4, b = inner whole.tag + whole.step + 10 }
let read r = (r : { a : int, b : int }).b
let a = print_int (read (choose { step = 0, tag = < hit 0 > }))
let b = print_int (read (choose { tag = < hit 7 >, step = 4 }))
let c = print_int (read (choose { tag = < miss 8 >, step = 0 }))
let main = print_int (read (choose { step = 4, tag = < miss 8 > }))
