(* The outer and shadowed occurrences of a keep their order after settlement. *)
let rec first count = if count == 0 then { b = 9, a = 7, a = 3 } else second (count - 1)
and second count = if count == 0 then { a = 8, b = 6, a = 4 } else third (count - 1)
and third count = if count == 0 then { a = 9, a = 5, b = 7 } else first (count - 1)
let read r = let aligned = (r : { a : int, b : int, a : int }) in let shown = print_int aligned.a in let rest = { aligned - a } in print_int rest.a
let x0 = read (first 100000)
let x1 = read (first 100001)
let main = read (first 100002)
