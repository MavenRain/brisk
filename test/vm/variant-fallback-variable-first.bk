let unpack v = match (v : < hit : int, miss : int >) with | < hit n > -> n | < miss n > -> n + 10
let read v = match (v : < hit : int, miss : int >) with | whole -> unpack whole | < hit n > -> n + 100 | < miss n > -> n + 200
let a = print_int (read (< hit 2 >))
let main = print_int (read (< miss 8 >))
